// ============================================================
// Bhaama Veedhi — Prisma Schema
// (Adapts the Firestore schema requirement to Prisma + SQLite.)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/*
  Product document — adapts the requested Firestore structure:
  {
    id, title, description, currentPrice, previousPrice (optional),
    images[], category, inStock, createdAt
  }
  - `images`: JSON-encoded array of image URL strings (SQLite can't store a
    scalar list directly, so we keep it as a String holding a JSON array).
    The API layer serializes (stringify) on write and deserializes (parse)
    on read so the frontend always receives `images: string[]`.
  - `category`: a free-text field the admin can fill with any value
    (e.g. "Necklaces", "Bridal", "Festive"). The storefront + navbar derive
    their filter chips dynamically from the distinct categories in use.
*/
model Product {
  id            String   @id @default(cuid())
  title         String
  description   String
  currentPrice  Int
  previousPrice Int?
  images        String   @default("[]")
  category      String   @default("All")
  inStock       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/*
  User accounts for the storefront (email/password auth).
  Admin access is role-based; the admin account is seeded with role "ADMIN".
*/
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
